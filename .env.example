# Required
BOT_TOKEN=123456789:YOUR_BOT_TOKEN
MODERATION_CHAT_ID=-1000000000000
ADMIN_IDS=881379104

# Mini App URL (must be HTTPS domain added in BotFather /setdomain)
WEBAPP_URL=https://bothost.tech.cxrner/

# Optional: run built-in static server for webapp/ directory
ENABLE_WEB_SERVER=1
WEB_SERVER_PORT=3000
BOT_BACKEND_SECRET=change-this-to-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: allow the Next.js site to use the same bot gateway for Mini App auth.
MINIAPP_ORIGIN=https://bothost.tech.cxrner
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=3000
# On platforms like bothost, PORT can be set automatically by host
# PORT=8080

# Optional OpenAI/HF (promo generation)
OPENAI_API_KEY=
